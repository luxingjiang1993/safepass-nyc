# ============================================================================
# Docker 构建上下文排除清单（票 13 / M4）
# 原则：镜像只装运行时必需物——应用代码、集中配置、fixtures 数据资产。
# 测试世界（tests/ 钉到 mock 数据集）与密钥、课程材料永不进镜像。
# ============================================================================

# VCS 与本地环境
.git/
.gitignore
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 密钥与本地配置（永不进镜像）
.env
.claude/settings.local.json

# 课程参考代码（版权不可再分发）
可用来参考的代码案例/

# 测试世界不进运行时镜像（conftest 会把数据集钉到 mock；生产镜像
# 要的是 config data_source.runtime_dataset_path 指向的真实数据集）
tests/

# 迭代与运营产物
.scratch/
logs/
ralph-run-*.log
afk-ralph.sh
ralph-once.sh
harness.yaml
progress.txt
Dockerfile
.dockerignore
