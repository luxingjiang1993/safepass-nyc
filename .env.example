# SafePass 环境变量接口文档（占位符模板，无真实密钥）。
#
# 用法：复制为 .env（已在 .gitignore，永不入库）后填真实值；加载方式：
#     set -a && source .env && set +a
# 纪律（Windows）：
#   - UTF-8 无 BOM；键名纯 ASCII 大写；`KEY=value` 等号两侧无空格；
#     值无引号、无行内注释，含特殊字符才加引号
#   - 真实密钥绝不贴进聊天/截图/仓库；轮换 = 只改 .env 这一处（单一事实源）

# --- 全线路由：DashScope qwen-flash（2026-09-08 统一，生产与 dev 同源）----
# L2 judge 录制（scripts/record_l2_cassette.py）与合成用户预检
# （scripts/run_synthetic_precheck.py）用 DASHSCOPE_API_KEY。
# 生产 LLM 接线唯一注入点：safepass/llm_wiring.py 读取以下三个变量，
# 任一缺失/空白即回退无 LLM 确定性路径（不静默降级）。
DASHSCOPE_API_KEY=sk-your-dashscope-key
# LLM_API_KEY 与 DASHSCOPE_API_KEY 同值（同一 DashScope 账号，两行都要填）。
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-flash
